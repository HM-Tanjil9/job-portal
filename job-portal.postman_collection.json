            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the login response",
                  "const response = pm.response.json();",
                  "",
                  "// Check different possible token locations",
                  "let token = null;",
                  "",
                  "// Try common token field names based on your API response",
                  "if (response.token) {",
                  "    token = response.token;",
                  "} else if (response.access_token) {",
                  "    token = response.access_token;",
                  "} else if (response.data && response.data.token) {",
                  "    token = response.data.token;",
                  "} else if (response.authorization) {",
                  "    token = response.authorization.replace('Bearer ', '');",
                  "}",
                  "",
                  "// Save the token if found",
                  "if (token) {",
                  "    // Save to the collection variable (which we can see in your Variables tab)",
                  "    pm.collectionVariables.set(\"token\", token);",
                  "    ",
                  "    // Optional: Also show success message in console",
                  "    console.log(\"✅ Token updated successfully!\");",
                  "    console.log(\"Token preview:\", token.substring(0, 20) + \"...\");",
                  "    ",
                  "    // Optional: Add a test to confirm",
                  "    pm.test(\"Token was saved to collection variable\", function() {",
                  "        pm.expect(pm.collectionVariables.get(\"token\")).to.not.be.empty;",
                  "    });",
                  "} else {",
                  "    console.log(\"❌ No token found in response\");",
                  "    console.log(\"Full response:\", response);",
                  "    ",
                  "    // This will help identify the response structure",
                  "    if (response) {",
                  "        console.log(\"Response keys:\", Object.keys(response));",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
